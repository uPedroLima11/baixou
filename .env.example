# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
# Only server / GitHub Actions secrets
SUPABASE_SERVICE_ROLE_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional: enable individual store adapters after robots/live validation
COLLECT_STORES=terabyte,pichau,kabum
COLLECT_MAX_PRODUCTS=36
OFFER_TTL_MINUTES=30
NOTIFY_MAX_EMAILS=50
